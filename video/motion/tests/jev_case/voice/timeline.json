   "t0": 0.3,
   "t1": 3.5,
   "who": "旁白",
   "text": "宴会上，智伯举着杯子哈哈大笑，当众取笑韩康子。",
   "audio": null,
   "voiced_end": 2.8,
   "i": 0
  },
  {
   "t0": 3.8,
   "t1": 7.0,
   "who": "智伯",
   "text": "韩康子，给我一座城！",
   "audio": null,
   "voiced_end": 2.8,
   "i": 1
  },
  {
   "t0": 7.3,
   "t1": 10.5,
   "who": "旁白",
   "text": "韩康子很为难，抱着地图卷，不想给。",
   "audio": null,
   "voiced_end": 2.8,
   "i": 2
  },
  {
   "t0": 10.8,
   "t1": 14.0,
   "who": "旁白",
   "text": "智伯有五样本事，样样比别人强！",
