{
 "duration": 67.7,
 "lines": [
  {
   "t0": 0.3,
   "t1": 2.9,
   "who": "旁白",
   "text": "要地，给不给？",
   "audio": null,
   "voiced_end": 2.1,
   "i": 0
  },
  {
   "t0": 3.2,
   "t1": 6.2,
   "who": "智伯",
   "text": "韩康子，给我一座城！",
   "audio": null,
   "voiced_end": 2.5,
   "i": 1
  },
  {
   "t0": 6.5,
   "t1": 9.1,
   "who": "韩康子",
   "text": "给……给你吧。",
   "audio": null,
   "voiced_end": 2.1,
   "i": 2
  },
  {
   "t0": 9.4,
   "t1": 12.4,
   "who": "段规",
   "text": "给了他，他更骄傲。",
   "audio": null,
   "voiced_end": 2.5,
   "i": 3
  },
  {
   "t0": 12.7,
   "t1": 16.1,
   "who": "旁白",
   "text": "智伯有五样本事，样样比别人强！",
   "audio": null,
   "voiced_end": 2.9,
   "i": 4
  },
  {
   "t0": 16.4,
   "t1": 19.0,
   "who": "旁白",
   "text": "只缺一样：好心。",
   "audio": null,
   "voiced_end": 2.1,
   "i": 5
  },
  {
   "t0": 19.3,
   "t1": 22.3,
   "who": "司马光",
   "text": "考考你，赵襄子给不给？",
   "audio": null,
   "voiced_end": 2.5,
   "i": 6
  },
  {
   "t0": 22.6,
   "t1": 24.2,
   "who": "赵襄子",
   "text": "不给。",
   "audio": null,
   "voiced_end": 1.1,
   "i": 7
  },
  {
   "t0": 24.5,
   "t1": 27.1,
   "who": "智伯",
   "text": "什么？你不给？",
   "audio": null,
   "voiced_end": 2.1,
   "i": 8
  },
  {
   "t0": 27.4,
   "t1": 29.6,
   "who": "旁白",
   "text": "智伯很生气！",
   "audio": null,
   "voiced_end": 1.7,
   "i": 9
  },
  {
   "t0": 29.9,
   "t1": 32.5,
   "who": "段规",
   "text": "变，就要来了。",
   "audio": null,
   "voiced_end": 2.1,
   "i": 10
  },
  {
   "t0": 32.8,
   "t1": 35.2,
   "who": "韩康子",
   "text": "我们再看看。",
   "audio": null,
   "voiced_end": 1.9,
   "i": 11
  },
  {
   "t0": 35.5,
   "t1": 38.9,
   "who": "旁白",
   "text": "智伯去看水势，得意大笑。",
   "audio": null,
   "voiced_end": 2.9,
   "i": 12
  },
  {
   "t0": 39.2,
   "t1": 41.8,
   "who": "智伯",
   "text": "水，也能灭国！",
   "audio": null,
   "voiced_end": 2.1,
   "i": 13
  },
  {
   "t0": 42.1,
   "t1": 44.7,
   "who": "韩康子",
   "text": "他，他说什么？",
   "audio": null,
   "voiced_end": 2.1,
   "i": 14
  },
  {
   "t0": 45.0,
   "t1": 48.6,
   "who": "旁白",
   "text": "韩康子的心里，都发凉。",
   "audio": null,
   "voiced_end": 3.1,
   "i": 15
  },
  {
   "t0": 48.9,
   "t1": 51.3,
   "who": "司马光",
   "text": "记住这句话。",
   "audio": null,
   "voiced_end": 1.9,
   "i": 16
  },
  {
   "t0": 51.6,
   "t1": 55.2,
   "who": "旁白",
   "text": "本事是本钱，好心是队长。",
   "audio": null,
   "voiced_end": 3.1,
   "i": 17
  },
  {
   "t0": 55.5,
   "t1": 58.7,
   "who": "赵襄子",
   "text": "晋阳，我们守得住！",
   "audio": null,
   "voiced_end": 2.7,
   "i": 18
  },
  {
   "t0": 59.0,
   "t1": 61.6,
   "who": "段规",
   "text": "夜里，挖开堤。",
   "audio": null,
   "voiced_end": 2.1,
   "i": 19
  },
  {
   "t0": 61.9,
   "t1": 64.3,
   "who": "旁白",
   "text": "水，掉头了！",
   "audio": null,
   "voiced_end": 1.9,
   "i": 20
  },
  {
   "t0": 64.6,
   "t1": 67.4,
   "who": "司马光",
   "text": "才胜德，就会输。",
   "audio": null,
   "voiced_end": 2.3,
   "i": 21
  }
 ],
