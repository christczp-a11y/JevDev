{
 "duration": 101.5,
 "lines": [
  {
   "i": 0,
   "t0": 0.3,
   "t1": 2.8,
   "who": "司马光",
   "text": "最强的智伯，被浇成了落汤鸡！",
   "visual": "智伯被大水浇成落汤鸡（笑点）"
  },
  {
   "i": 1,
   "t0": 3.1,
   "t1": 6.9,
   "who": "旁白",
   "text": "两千四百年前，晋国最强的人，就是他。",
   "visual": "日历飞速倒翻"
  },
  {
   "i": 2,
   "t0": 8.1,
   "t1": 10.3,
   "who": "旁白",
   "text": "最强的智伯，为什么输了？",
   "visual": "大问题横幅"
  },
  {
   "i": 3,
   "t0": 10.6,
   "t1": 15.3,
   "who": "旁白",
   "text": "智伯本事大，可对人不好，智家会没！",
   "visual": "五个图标亮起"
  },
  {
   "i": 4,
   "t0": 15.6,
   "t1": 18.2,
   "who": "司马光",
   "text": "可是他对人不好。",
   "visual": "（铺垫）"
  },
  {
   "i": 5,
   "t0": 18.5,
   "t1": 22.0,
   "who": "旁白",
   "text": "宴会上，智伯取笑韩康子。",
   "visual": "第 1 关：忍。横幅「第 1 关」；段规攥着袖子"
  },
  {
   "i": 6,
   "t0": 22.3,
   "t1": 23.8,
   "who": "动作",
   "text": "",
   "visual": "智伯把自己的杯子碰倒了（笑点）"
  },
  {
   "i": 7,
   "t0": 24.1,
   "t1": 26.4,
   "who": "段规",
   "text": "主公，听我一句！",
   "visual": "段规拉了拉智伯的袖子"
  },
  {
   "i": 8,
   "t0": 26.7,
   "t1": 29.0,
   "who": "智伯",
   "text": "不听！我不惹事！",
   "visual": "一只蚂蚁爬上他的鞋（笑点）"
  },
  {
   "i": 9,
   "t0": 29.3,
   "t1": 31.3,
   "who": "旁白",
   "text": "第 2 关：要地。",
   "visual": "第 2 关：给。段规拉住韩康子"
  },
  {
   "i": 10,
   "t0": 31.6,
   "t1": 32.7,
   "who": "段规",
   "text": "给他！",
   "visual": "段规凑到韩康子耳边"
  },
  {
   "i": 11,
   "t0": 33.0,
   "t1": 34.1,
   "who": "赵襄子",
   "text": "不给。",
   "visual": "赵襄子端坐不动"
  },
  {
   "i": 12,
   "t0": 34.4,
   "t1": 35.4,
   "who": "动作",
   "text": "",
   "visual": "全场一静，只有青蛙「呱」了一声（笑点）"
  },
  {
   "i": 13,
   "t0": 35.7,
   "t1": 39.7,
   "who": "司马光",
   "text": "考考你：给还是不给？弹幕告诉我！",
   "visual": "司马光举牌定格，弹幕飘过"
  },
  {
   "i": 14,
   "t0": 40.0,
   "t1": 44.1,
   "who": "旁白",
   "text": "给的，是韩、魏；不给的，是赵襄子。",
   "visual": "「计」字纸牌翻开"
  },
  {
   "i": 15,
   "t0": 44.4,
   "t1": 47.3,
   "who": "司马光",
   "text": "智伯怒了，要动手了！",
   "visual": "司马光探头"
  },
  {
   "i": 16,
   "t0": 47.6,
   "t1": 50.2,
   "who": "智伯",
   "text": "冲过来！气死我了！",
   "visual": "三面旗子围上来；智伯气得鬓发竖起（笑点）；段规站在韩康子身后"
  },
  {
   "i": 17,
   "t0": 50.5,
   "t1": 55.2,
   "who": "旁白",
   "text": "答案先揭一半：他以为大家都怕他！",
   "visual": "大问题横幅翻开一半"
  },
  {
   "i": 18,
   "t0": 55.5,
   "t1": 58.1,
   "who": "司马光",
   "text": "他以为自己最大！",
   "visual": "（铺垫）"
  },
  {
   "i": 19,
   "t0": 58.4,
   "t1": 60.7,
   "who": "旁白",
   "text": "第 3 关，最难：反！",
   "visual": "第 3 关；段规站在韩康子身后"
  },
  {
   "i": 20,
   "t0": 61.0,
   "t1": 63.3,
   "who": "智伯",
   "text": "哈哈！水能灭国！",
   "visual": "智伯站在战车上大笑"
  },
  {
   "i": 21,
   "t0": 63.6,
   "t1": 65.1,
   "who": "动作",
   "text": "",
   "visual": "魏桓子碰了一下韩康子的胳膊肘（笑点）"
  },
  {
   "i": 22,
   "t0": 65.4,
   "t1": 68.0,
   "who": "司马光",
   "text": "他俩心里，也慌了！",
   "visual": "司马光探头"
  },
  {
   "i": 23,
   "t0": 68.3,
   "t1": 70.0,
   "who": "段规",
   "text": "咱们也怕！",
   "visual": "两人身后各浮出一座城"
  },
  {
   "i": 24,
   "t0": 70.3,
   "t1": 74.4,
   "who": "旁白",
   "text": "段规说过：等着变。这个变，来了！",
   "visual": "段规微微点头（艺术化演绎）"
  },
  {
   "i": 25,
   "t0": 74.7,
   "t1": 76.7,
   "who": "动作",
   "text": "",
   "visual": "大水冲垮营帐；智伯鬓发湿成一团（笑点）"
  },
  {
   "i": 26,
   "t0": 77.0,
   "t1": 79.6,
   "who": "智伯",
   "text": "我败了！智家没了！",
   "visual": "智伯的旗子倒在水里"
  },
  {
   "i": 27,
   "t0": 79.9,
   "t1": 84.3,
   "who": "旁白",
   "text": "五十年后，三家的后代封为诸侯。",
   "visual": "周王宫；三面旗子"
  },
  {
   "i": 28,
   "t0": 84.6,
   "t1": 86.9,
   "who": "旁白",
   "text": "写书的人，来了——",
   "visual": "画面压暗"
  },
  {
   "i": 29,
   "t0": 87.2,
   "t1": 91.3,
   "who": "司马光",
   "text": "才者，德之资也；德者，才之帅也。",
   "visual": "司马光手指点在书页上"
  },
  {
   "i": 30,
   "t0": 91.6,
   "t1": 94.8,
   "who": "旁白",
   "text": "意思就是：好心是队长。",
   "visual": "（金句 3/3）"
  },
  {
   "i": 31,
   "t0": 95.1,
   "t1": 96.6,
   "who": "动作",
   "text": "",
   "visual": "一只青蛙跳上书页（笑点）"
  },
  {
   "i": 32,
   "t0": 96.9,
   "t1": 101.0,
   "who": "旁白",
   "text": "下集预告：一个下雨天的约会。",
   "visual": "问号纸牌翻出：雨点"
  }
 ]
}