 "lines": [
  {
   "i": 0,
   "t0": 0.3,
   "t1": 1.5,
   "who": "司马光",
   "text": "考考你！",
   "visual": "司马光弹出来（笑点：青蛙「呱」）"
  },
  {
   "i": 1,
   "t0": 1.8,
   "t1": 2.8,
   "who": "旁白",
   "text": "给不给？",
   "visual": "屏幕弹出大字「有人要地」和【给】【不给】"
  },
  {
   "i": 2,
   "t0": 3.1,
   "t1": 4.1,
   "who": "动作",
   "text": "",
   "visual": "停 1 秒（考你 1/4）：倒计时转圈、滴答声；不揭晓"
  },
  {
   "i": 3,
   "t0": 5.3,
   "t1": 7.3,
   "who": "旁白",
   "text": "最强的智伯，为什么输了？",
   "visual": "大问题横幅"
  },
  {
   "i": 4,
   "t0": 7.6,
   "t1": 12.3,
   "who": "旁白",
   "text": "智伯本事大，可对人不好，智家会没！",
   "visual": "五个图标亮起"
  },
  {
   "i": 5,
   "t0": 12.6,
   "t1": 16.4,
   "who": "旁白",
   "text": "他的意思就是：好心是队长。",
   "visual": "（金句 1/3）"
  },
  {
   "i": 6,
   "t0": 16.7,
   "t1": 20.2,
   "who": "旁白",
   "text": "宴会上，智伯取笑韩康子。",
   "visual": "第 1 关：忍。横幅「第 1 关」；段规攥着袖子"
  },
  {
   "i": 7,
   "t0": 20.5,
   "t1": 22.0,
   "who": "动作",
   "text": "",
   "visual": "智伯把自己的杯子碰倒了（笑点）"
  },
  {
   "i": 8,
   "t0": 22.3,
   "t1": 25.2,
   "who": "司马光",
   "text": "考你：智伯听不听劝？",
   "visual": "（考你 2/4）【听】【不听】"
  },
  {
   "i": 9,
   "t0": 25.5,
   "t1": 26.7,
   "who": "动作",
   "text": "",
   "visual": "停 1.2 秒：倒计时转圈、滴答声；不揭晓"
  },
  {
   "i": 10,
   "t0": 27.0,
   "t1": 28.4,
   "who": "司马光",
   "text": "看答案！",
   "visual": "【不听】亮起"
  },
  {
   "i": 11,
   "t0": 28.7,
   "t1": 31.0,
   "who": "智伯",
   "text": "不听！我不惹事！",
   "visual": "一只蚂蚁爬上他的鞋（笑点）"
  },
  {
   "i": 12,
   "t0": 31.3,
   "t1": 33.3,
   "who": "旁白",
   "text": "第 2 关：要地。",
   "visual": "第 2 关：给。段规拉住韩康子"
  },
  {
   "i": 13,
   "t0": 33.6,
   "t1": 34.7,
   "who": "段规",
   "text": "给他！",
   "visual": "段规凑到韩康子耳边"
  },
  {
   "i": 14,
   "t0": 35.0,
   "t1": 36.1,
   "who": "赵襄子",
   "text": "不给。",
   "visual": "赵襄子端坐不动"
  },
  {
   "i": 15,
   "t0": 36.4,
   "t1": 37.4,
   "who": "动作",
   "text": "",
   "visual": "全场一静，只有青蛙「呱」了一声（笑点）"
  },
  {
   "i": 16,
   "t0": 37.7,
   "t1": 39.1,
   "who": "司马光",
   "text": "看答案！",
   "visual": "【给】亮起；接着【不给】亮起"
  },
  {
   "i": 17,
   "t0": 39.4,
   "t1": 43.5,
   "who": "旁白",
   "text": "给的，是韩、魏；不给的，是赵襄子。",
   "visual": "「计」字纸牌翻开"
  },
  {
   "i": 18,
   "t0": 43.8,
   "t1": 46.7,
   "who": "司马光",
   "text": "考你：智伯会怎么办？",
   "visual": "（考你 3/4）【算了】【冲过来】"
  },
  {
   "i": 19,
   "t0": 47.0,
   "t1": 48.2,
   "who": "动作",
   "text": "",
   "visual": "停 1.2 秒：倒计时转圈、滴答声；不揭晓"
  },
  {
   "i": 20,
   "t0": 48.5,
   "t1": 49.9,
   "who": "司马光",
   "text": "看答案！",
   "visual": "【冲过来】亮起"
  },
  {
   "i": 21,
   "t0": 50.2,
   "t1": 52.8,
   "who": "智伯",
   "text": "冲过来！气死我了！",
   "visual": "三面旗子围上来；智伯气得鬓发竖起（笑点）；段规站在韩康子身后"
  },
  {
   "i": 22,
   "t0": 53.1,
   "t1": 57.8,
   "who": "旁白",
   "text": "答案先揭一半：他以为大家都怕他！",
   "visual": "大问题横幅翻开一半"
  },
  {
   "i": 23,
   "t0": 58.1,
   "t1": 60.1,
   "who": "旁白",
   "text": "好心是队长。",
   "visual": "（金句 2/3）"
  },
  {
   "i": 24,
   "t0": 60.4,
   "t1": 62.7,
   "who": "旁白",
   "text": "第 3 关，最难：反！",
   "visual": "第 3 关；段规站在韩康子身后"
  },
  {
   "i": 25,
   "t0": 63.0,
   "t1": 65.3,
   "who": "智伯",
   "text": "哈哈！水能灭国！",
   "visual": "智伯站在战车上大笑"
  },
  {
   "i": 26,
   "t0": 65.6,
   "t1": 67.1,
   "who": "动作",
   "text": "",
   "visual": "魏桓子碰了一下韩康子的胳膊肘（笑点）"
  },
  {
   "i": 27,
   "t0": 67.4,
   "t1": 70.0,
   "who": "司马光",
   "text": "考你：他俩说什么？",
   "visual": "（考你 4/4）【咱们也怕】"
  },
  {
   "i": 28,
   "t0": 70.3,
   "t1": 72.1,
   "who": "动作",
   "text": "",
   "visual": "停 1.8 秒：倒计时转圈、滴答声；不揭晓"
  },
  {
   "i": 29,
   "t0": 72.4,
   "t1": 73.8,
   "who": "司马光",
   "text": "看答案！",
   "visual": "【咱们也怕】亮起"
  },
  {
   "i": 30,
   "t0": 74.1,
   "t1": 75.8,
   "who": "段规",
   "text": "咱们也怕！",
   "visual": "两人身后各浮出一座城"
  },
  {
   "i": 31,
   "t0": 76.1,
   "t1": 80.2,
   "who": "旁白",
   "text": "段规说过：等着变。这个变，来了！",
   "visual": "段规微微点头（艺术化演绎）"
  },
  {
   "i": 32,
   "t0": 80.5,
   "t1": 82.5,
   "who": "动作",
   "text": "",
   "visual": "大水冲垮营帐；智伯鬓发湿成一团（笑点）"
  },
  {
   "i": 33,
   "t0": 82.8,
   "t1": 85.4,
   "who": "智伯",
   "text": "我败了！智家没了！",
   "visual": "智伯的旗子倒在水里"
  },
  {
   "i": 34,
   "t0": 85.7,
   "t1": 90.1,
   "who": "旁白",
   "text": "五十年后，三家的后代封为诸侯。",
   "visual": "周王宫；三面旗子"
  },
  {
   "i": 35,
   "t0": 90.4,
   "t1": 92.7,
   "who": "旁白",
   "text": "写书的人，来了——",
